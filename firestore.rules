rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.id == userId
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 256
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    function isValidPlant(data, userId) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.userId == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 128
        && data.started is string
        && data.started.size() <= 32
        && data.stage is string
        && data.stage.size() <= 32
        && data.stageStarted is string
        && data.stageStarted.size() <= 32;
    }

    function isValidScan(data, userId) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.userId == userId
        && data.condition is string
        && data.condition.size() > 0
        && data.condition.size() <= 256
        && data.analysis is string
        && data.analysis.size() > 0
        && data.analysis.size() <= 4096
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if false;

      // Plants subcollection
      match /plants/{plantId} {
        allow get: if isValidId(userId) && isValidId(plantId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(plantId) && isOwner(userId) && isValidPlant(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(plantId) && isOwner(userId) && isValidPlant(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(plantId) && isOwner(userId);
      }

      // Scans subcollection
      match /scans/{scanId} {
        allow get: if isValidId(userId) && isValidId(scanId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(scanId) && isOwner(userId) && isValidScan(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(scanId) && isOwner(userId) && isValidScan(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(scanId) && isOwner(userId);
      }
    }
  }
}
